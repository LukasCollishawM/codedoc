{
  "name": "codedoc",
  "displayName": "codedoc",
  "description": "Durable, AST-anchored documentation shown as hovers and code lenses.",
  "version": "1.0.0",
  "publisher": "codedoc",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LukasCollishawM/codedoc"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "codedoc",
      "properties": {
        "codedoc.serverPath": {
          "type": "string",
          "default": "codedoc-lsp",
          "description": "Path to the codedoc-lsp executable. Must be on PATH or absolute."
        },
        "codedoc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the codedoc language server."
        }
      }
    },
    "commands": [
      {
        "command": "codedoc.showRecord",
        "title": "codedoc: Show record"
      },
      {
        "command": "codedoc.restart",
        "title": "codedoc: Restart server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
