{"anchors":[{"anchor":{"content":"cf4e590ce719c8b21283e7e41668d1deea8a7431172908bb7e538f72e09373b1","context_siblings":4,"file":"crates/codedoc-core/src/canonical.rs","following":"c0db5373f2ccc0fcac3751828ebf18137a4f06e5002884cff07d4e1daa0ed41a","language":"rust","node_kind":"enum_item","node_path":[],"preceding":"a80acebfaabb072f2bea8631c5ca1274681db1f77f02f551f4c63f1da3917fd6","range":{"end_column":2,"end_line":17,"start_column":1,"start_line":10},"shape":{"enum_item":1,"enum_variant":6,"enum_variant_list":1,"generic_type":2,"identifier":6,"ordered_field_declaration_list":5,"primitive_type":2,"type_arguments":2,"type_identifier":7,"visibility_modifier":1},"structural":"3a377f480cf7a9b121c3261c54481db4a96aa06471ee42d6da58626ccba38241","symbol":"rust://Canonical","symbol_kind":"enum_item"},"role":"subject"}],"assurance":"asserted","author":{"authority":"agent","model":"claude-opus-5","session":"init-session"},"body":{"claim":"The canonical value type has no floating point variant, so a float is unrepresentable rather than rejected by a check somebody has to remember to write.","detail":"A record identity is the hash of its canonical bytes, and a float has no single byte form, so admitting one would make identity platform-dependent. A validation step can be skipped on a new code path; a type that cannot hold the value cannot be. This is what the specification means by making it a property of the value type."},"chain":"82ea71dd091307d7ea0aa9bfefc01227bec016d89593003ca40aa6bce0af72eb","code_revision":"c64a34296e8c834c5e7005bf9e912b86448483b3","created":1790236390,"kind":"invariant","lifecycle":"active","parent":"4dc37f5b89a782110db5febf8ad98bfb74001e174644c2eaaa0dffd471d58218","schema":1}
{"anchors":[{"anchor":{"content":"31059d902f2a9978aca03a14f0c1f7fe97821a04e5710cf3f60cdc31371ccc9d","context_siblings":4,"file":"crates/codedoc-ops/src/import.rs","following":"e506f2f085c2c1404ebb7ca1f13018f38669703ce95e799d1f9eabb495b42b72","language":"rust","node_kind":"function_item","node_path":[],"preceding":"08e78c858cb99698297bfc58d2ca3761b56bcb0b31883f7066a3a1d4c9936e6d","range":{"end_column":2,"end_line":482,"start_column":1,"start_line":469},"shape":{"arguments":15,"array_expression":1,"block":4,"call_expression":15,"char_literal":4,"expression_statement":5,"field_expression":15,"field_identifier":15,"for_expression":1,"function_item":1,"identifier":22,"if_expression":2,"let_condition":2,"let_declaration":3,"parameter":1,"parameters":1,"primitive_type":1,"reference_type":1,"return_expression":2,"string_content":4,"string_literal":4,"tuple_struct_pattern":2,"type_identifier":1},"structural":"fea482bc52cf6507874f40009dece789aab747c5ceb4f840cc03fd226f12e115","symbol":"rust://strip_markers","symbol_kind":"function_item"},"role":"subject"}],"assurance":"asserted","author":{"authority":"agent","model":"claude-opus-5","session":"unrecorded"},"body":{"claim":"Stripping a marker after the comment character must know which character opened the comment.","detail":"Python attribute docs open with #: and Doxygen uses ///< and //!<, so a marker is stripped after the introducer. Treating the markers as a single set turns a shebang into a claim: #! strips to /usr/bin/env python, which is nineteen characters and passes the minimum length. Colons are stripped only after #, angle brackets only after slashes, and a shebang node is dropped from its block rather than the whole block being skipped, which would lose the real comment beneath it."},"chain":"2ccb38d5913817bbf202d2cd4304f238a386e28cb0cfede9fb170ba1c43930b0","code_revision":"3598512dd0c6aa2668976cc3040f419a14d6c002","created":1790241978,"kind":"known_failure_mode","lifecycle":"active","schema":1}
